{
  "name": "reveal-presenter",
  "version": "0.1.0",
  "description": "Desktop presentation viewer for reveal.js",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.revealjs.presenter",
    "productName": "Reveal Presenter",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "bundle/**/*"
    ],
    "extraResources": [
      {
        "from": "bundle",
        "to": "bundle",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^42.2.0"
  },
  "dependencies": {
    "node-pptx-parser": "^1.0.1"
  }
}
